generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  super_admin
  editor
  recruiter
  support
}

// ─── Site ────────────────────────────────────────────────────────────────────

model SiteSettings {
  id             String  @id @default("global")
  name           String
  fullName       String
  tagline        String
  description    String
  logoUrl        String
  siteUrl        String
  contactEmail   String
  whatsappNumber String?
  facebookUrl    String?
  linkedinUrl    String?
  web3formsKey   String
}

model PageSeo {
  pageSlug    String  @id
  title       String?
  description String?
  ogImageUrl  String?
}

model AboutSettings {
  id String @id @default("global")

  // Profile block
  profileEyebrow       String   @default("")
  profileHeading       String   @default("")
  profileHeadingAccent String   @default("")
  profileParagraphs    String[]
  profilePrimaryImage    String @default("")
  profilePrimaryImageAlt String @default("")
  profileSecondaryImage    String @default("")
  profileSecondaryImageAlt String @default("")

  // Mission
  missionBody            String   @default("")
  missionPoints          String[]
  missionPrimaryImage    String   @default("")
  missionPrimaryImageAlt String   @default("")
  missionSecondaryImage    String @default("")
  missionSecondaryImageAlt String @default("")

  // Vision
  visionBody            String   @default("")
  visionPoints          String[]
  visionPrimaryImage    String   @default("")
  visionPrimaryImageAlt String   @default("")
  visionSecondaryImage    String @default("")
  visionSecondaryImageAlt String @default("")

  // What We Stand For (values labels)
  valuesLabels String[]

  // Commitment
  commitmentBody            String   @default("")
  commitmentPoints          String[]
  commitmentPrimaryImage    String   @default("")
  commitmentPrimaryImageAlt String   @default("")
  commitmentSecondaryImage    String @default("")
  commitmentSecondaryImageAlt String @default("")

  // Why Choose Us
  whyTitle         String @default("")
  whyHeading       String @default("")
  whyHeadingAccent String @default("")
  why1Title        String @default("")
  why1Description  String @default("")
  why2Title        String @default("")
  why2Description  String @default("")
  why3Title        String @default("")
  why3Description  String @default("")
  why4Title        String @default("")
  why4Description  String @default("")
  why5Title        String @default("")
  why5Description  String @default("")
  why6Title        String @default("")
  why6Description  String @default("")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id                       String    @id @default(cuid())
  slug                     String    @unique
  name                     String
  tagline                  String
  description              String
  status                   String    @default("In Development")
  imageUrl                 String
  features                 String[]
  builtFor                 String[]
  serviceId                String?
  service                  Service?  @relation(fields: [serviceId], references: [id])
  profileEyebrow           String
  profileHeading           String
  profileHeadingAccent     String?
  profileParagraphs        String[]
  profilePrimaryImageUrl   String
  profilePrimaryImageAlt   String
  profileSecondaryImageUrl String?
  profileSecondaryImageAlt String?
  published                Boolean   @default(false)
  order                    Int       @default(0)
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([serviceId])
  @@index([published, deletedAt])
}

// ─── Services ────────────────────────────────────────────────────────────────

model Service {
  id                     String                   @id @default(cuid())
  slug                   String                   @unique
  icon                   String
  profileEyebrow         String
  profileHeading         String
  profileHeadingAccent   String?
  profileParagraphs      String[]
  profilePrimaryImageUrl String
  profilePrimaryImageAlt String
  published              Boolean                  @default(false)
  order                  Int                      @default(0)
  deletedAt              DateTime?
  methodology            ServiceMethodologyStep[]
  products               Product[]
  solutions              Solution[]
  articles               Article[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([published, deletedAt])
}

model ServiceMethodologyStep {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String
  order       Int     @default(0)
}

// ─── Solutions ───────────────────────────────────────────────────────────────

model Solution {
  id        String    @id @default(cuid())
  title     String
  summary   String
  serviceId String?
  service   Service?  @relation(fields: [serviceId], references: [id])
  published Boolean   @default(false)
  order     Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([serviceId])
  @@index([published, deletedAt])
}

// ─── Careers ─────────────────────────────────────────────────────────────────

model JobListing {
  id                      String           @id @default(cuid())
  slug                    String           @unique
  title                   String
  description             String
  location                String
  type                    String
  category                String
  minQualifications       String[]
  preferredQualifications String[]
  aboutJob                String?
  active                  Boolean          @default(true)
  order                   Int              @default(0)
  deletedAt               DateTime?
  applications            JobApplication[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model JobApplication {
  id           String     @id @default(cuid())
  jobListingId String
  jobListing   JobListing @relation(fields: [jobListingId], references: [id])
  fullName     String
  email        String
  phone        String?
  coverLetter  String
  resumeUrl    String?
  linkedinUrl  String?
  status       AppStatus  @default(new)
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum AppStatus {
  new
  reviewing
  interviewed
  hired
  rejected
}

// ─── Leadership ──────────────────────────────────────────────────────────────

model LeadershipMember {
  id        String    @id @default(cuid())
  memberId  String    @unique
  name      String
  title     String
  division  String
  focus     String
  bio       String
  imageUrl  String?
  linkedin  String?
  order     Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── Partners ────────────────────────────────────────────────────────────────

model Partner {
  id        String      @id @default(cuid())
  title     String
  logoUrl   String
  type      PartnerType
  slug      String?     @unique
  summary   String?
  points    String[]
  order     Int         @default(0)
  deletedAt DateTime?
}

enum PartnerType {
  logo
  category
}

// ─── Articles (Sanity → Neon sync) ───────────────────────────────────────────

model Article {
  id            String    @id @default(cuid())
  sanityId      String    @unique
  slug          String    @unique
  title         String
  category      String
  publishDate   String
  author        String
  summary       String
  sections      Json
  serviceId     String?
  service       Service?  @relation(fields: [serviceId], references: [id])
  coverImageUrl String
  likes         Int       @default(0)
  published     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([serviceId])
  @@index([published, deletedAt])
  @@index([category, published])
}

// ─── Contact ─────────────────────────────────────────────────────────────────

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(new)
  notes     String?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ContactStatus {
  new
  read
  responded
}

// ─── Client Pipeline ─────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  companyName     String
  contactName     String
  contactEmail    String
  contactPhone    String?
  serviceInterest String?
  status          ClientStatus @default(lead)
  estimatedValue  Float?
  notes           ClientNote[]
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ClientNote {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}

enum ClientStatus {
  lead
  proposal_sent
  negotiating
  won
  lost
}
